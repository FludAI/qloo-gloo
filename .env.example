# Copy to .env (never commit .env). Locally you can skip QLOO_API_KEY:
# `qloo setup --qloo` stores the key in the harness's private config.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
# QLOO_API_KEY=set-as-a-secret-on-your-server-only
PORT=8787
# 1 = serve labeled fixture data, no Qloo calls (for UI work before your key arrives)
QLOO_MOCK=0
