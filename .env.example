# Copy to .env (never commit .env). Server-side only; nothing here reaches the browser.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
# Locally, `qloo setup --qloo` stores the Qloo key privately and you can leave this unset.
# QLOO_API_KEY=
# Claude powers the cue agent. Unset = agent shows "unavailable"; the lesson still works.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=8787
# 1 = labeled fixture data and a synthetic agent, no Qloo or model calls.
QLOO_MOCK=0
# Optional: a module outside this repo that exports extra `terms`.
# GLOO_ENGINE_MODULE=../gloo-engine/index.mjs
